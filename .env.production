# Production — call Railway directly (CORS allows this origin on the backend).
# Do not use /api on Vercel unless vercel.json rewrite target is deployed and correct.
VITE_API_URL=https://dackend-trade-bot-production.up.railway.app

# Backend proxy target — not used in production build
# Production hosting should proxy /api/* to the backend service
API_TARGET=https://schwab-dackend-production.up.railway.app
# WebSocket origin (Vercel rewrites cannot proxy WebSockets, so this points straight at the backend)
VITE_SOCKET_URL=https://schwab-dackend-production.up.railway.app
