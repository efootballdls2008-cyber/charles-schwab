# Production Environment Configuration
VITE_API_URL=/api

# Backend proxy target — not used in production build
# Production hosting should proxy /api/* to the backend service
API_TARGET=https://schwab-dackend-production-4c6c.up.railway.app

# WebSocket origin (Vercel rewrites cannot proxy WebSockets, so this points straight at the backend)
VITE_SOCKET_URL=https://schwab-dackend-production-4c6c.up.railway.app