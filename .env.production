# ═══════════════════════════════════════════════════════════════
# Charles Schwab Frontend - Production Environment
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# API Configuration
# In production, use /api and configure Vercel to proxy to backend
# This keeps the backend URL hidden from the client
# ─────────────────────────────────────────────────────────────
VITE_API_URL=/api

# ─────────────────────────────────────────────────────────────
# Backend Proxy Target (for Vercel rewrites)
# Add this to vercel.json rewrites configuration
# NOT used in browser - only for server-side proxying
# ─────────────────────────────────────────────────────────────
API_TARGET=https://schwab-dackend-production-4c6c.up.railway.app

# ─────────────────────────────────────────────────────────────
# WebSocket Configuration
# Vercel cannot proxy WebSockets, so this points directly to backend
# ─────────────────────────────────────────────────────────────
VITE_SOCKET_URL=https://schwab-dackend-production-4c6c.up.railway.app

# ─────────────────────────────────────────────────────────────
# Deployment URLs
# ─────────────────────────────────────────────────────────────
# Frontend: https://charlesschwab-wine.vercel.app
# Admin Panel: https://schwabadmin.vercel.app
# Backend API: https://schwab-dackend-production-4c6c.up.railway.app